<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Imagem -->
        <ImageView
            android:id="@+id/imgProdutoCarrinho"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_circle_white" />

        <!-- Informacoes -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/txtNomeProduto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pizza Margherita"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <!-- Precos -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/txtPrecoOriginal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 89,90"
                    android:textSize="14sp"
                    android:textColor="@color/gray"
                    android:visibility="gone"
                    android:paintFlags="strikeThruText"/>

                <TextView
                    android:id="@+id/txtPrecoAtual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 59,90"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Controle de quantidade -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnRemoverQuantidade"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_remove"
                    android:background="@drawable/bg_circle_white"
                    android:padding="6dp"
                    android:elevation="2dp" />

                <TextView
                    android:id="@+id/txtQuantidade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="14sp"
                    android:layout_marginHorizontal="8dp"
                    android:textColor="@color/black"/>

                <ImageView
                    android:id="@+id/btnAdicionarQuantidade"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_add"
                    android:background="@drawable/bg_circle_white"
                    android:padding="6dp"
                    android:elevation="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Botao excluir -->
        <ImageView
            android:id="@+id/btnExcluirItem"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_delete"
            android:layout_marginStart="8dp"
            app:tint="@color/vermelho" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
