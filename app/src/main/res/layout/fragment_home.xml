<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayoutHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="24dp"
    android:layout_marginTop="20dp"
    android:padding="05dp">

    <!-- BANNER FIXO -->
    <LinearLayout
        android:id="@+id/blocoInfoEntrega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:elevation="6dp"
        android:background="@android:color/white"
        android:translationZ="10dp"
        android:layout_gravity="top">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_time"
            android:layout_marginEnd="4dp"
            app:tint="@color/gray" />

        <TextView
            android:id="@+id/txtTempoEntrega"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="40 min"
            android:textSize="14sp"
            android:textColor="@color/gray"
            android:layout_marginEnd="12dp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_truck"
            android:layout_marginEnd="4dp"
            app:tint="#57FD12" />

        <TextView
            android:id="@+id/txtFrete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frete Grátis!"
            android:textSize="14sp"
            android:textColor="#57FD12"
            android:layout_marginEnd="12dp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star"
            android:layout_marginEnd="4dp"
            app:tint="@android:color/holo_orange_light" />

        <TextView
            android:id="@+id/txtAvaliacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.8"
            android:textSize="14sp"
            android:textColor="@color/gray" />
    </LinearLayout>

    <!-- CONTEÚDO ROLÁVEL -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- LinearLayout raiz para conter o conteúdo -->
        <LinearLayout
            android:id="@+id/layoutHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


        <TextView
            android:id="@+id/tvSaudacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olá, Fulano 👋"
            android:textColor="@color/vermelho"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Endereço -->
        <TextView
            android:id="@+id/tvEndereco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="2dp"
            android:text="Av. Gourmet, 123"
            android:textColor="@color/purple_700"
            android:textSize="14sp"
            android:textStyle="italic" />

        <!-- Barra de busca -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#888" />

                <EditText
                    android:id="@+id/etBusca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Buscar pizzas, bebidas..."
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:paddingStart="8dp"
                    android:textColor="#000"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/textSemPromocoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Nenhuma promoção disponível no momento!"
            android:textAlignment="center"
            android:textColor="@android:color/darker_gray"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Promoções -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="20dp"
            android:background="@android:color/transparent">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerPromocoes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:padding="4dp"
                android:layout_margin="2dp"
                app:tabGravity="center"
                app:tabIndicatorColor="@android:color/transparent"
                app:tabIndicatorHeight="0dp"
                app:tabMode="scrollable"
                app:tabRippleColor="@android:color/transparent" />

        </FrameLayout>
        <!-- Horizontal categorias redondas -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                tools:listitem="@layout/item_categoria_scroll" />

            <!-- Destaques da Casa -->
        <TextView
            android:id="@+id/tvDestaques"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Destaques da Casa"
            android:textColor="#000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDestaques"
            android:layout_width="match_parent"
            android:layout_height="114dp"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            app:layout_anchor="@+id/nestedScroll"
            app:layout_anchorGravity="bottom|center" />



        <TextView
            android:id="@+id/tvCategoriasPizza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Por Tamanho(Salgada)"
            android:textColor="#000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPizzaTamanhos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="160dp"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            tools:listitem="@layout/item_pizza_tamanho"/>

        <TextView
            android:id="@+id/tvCategoriasPizzaDoce"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Por Tamanho (Doce)"
            android:textColor="#000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPizzaTamanhosDoce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="160dp"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            tools:listitem="@layout/item_pizza_tamanho"/>

        <!--Produtos-->
        <TextView
            android:id="@+id/tvProdutos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/cardapio"
            android:textColor="#000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProdutos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="8dp"
            />



    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
   </androidx.coordinatorlayout.widget.CoordinatorLayout>
