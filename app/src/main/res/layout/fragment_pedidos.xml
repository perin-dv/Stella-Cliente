<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Card de Pedido Ativo (conteúdo de item_pedido_status embutido) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPedidoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStatusLoja"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stella D’Italia"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvStatusNumeroData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedido nº 1234 • 10:30"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvResumoItensStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2x Calabresa + 1x Coca"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvTotalPedidoStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: R$ 58,00"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvStatusPedido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedido confirmado"
                    android:textColor="@android:color/holo_green_dark"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Título do Histórico -->
        <TextView
            android:id="@+id/tvHistoricoTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Histórico de pedidos"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <!-- RecyclerView de Histórico -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHistoricoPedidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
