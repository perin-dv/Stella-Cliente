<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@drawable/bg_card_gourmet"
    android:gravity="center_vertical">

    <!-- Imagem do adicional -->
    <ImageView
        android:id="@+id/imgAdicional"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_categoria_circle"
        android:src="@drawable/ic_bebidas" />

    <!-- Nome do adicional -->
    <TextView
        android:id="@+id/txtNomeAdicional"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:text="Refrigerante 350ml"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:fontFamily="@font/poppins_medium" />

    <!-- Preço -->
    <TextView
        android:id="@+id/txtPrecoAdicional"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$ 4,99"
        android:textSize="14sp"
        android:textColor="@color/colorPrimary"
        android:fontFamily="@font/poppins_medium" />

</LinearLayout>
