<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:elevation="6dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:radius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Loja + Data -->
        <TextView
            android:id="@+id/tvLoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stella D’Italia - Maringá"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pedido nº 1582 • 18/05/2025 19:45"
            android:textSize="13sp"
            android:textColor="#777777"
            android:layout_marginTop="2dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pedido confirmado"
            android:textColor="@color/vermelho"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

        <!-- Itens -->
        <TextView
            android:id="@+id/tvItensResumo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1x Pizza Broto (2 sabores) + 1x Coca-Cola 600ml"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
