<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nestedScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomeLoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stella D’Italia - Maringá"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvNumeroPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pedido nº 1582 • 18/05/2025 19:45"
            android:textSize="14sp"
            android:textColor="#777777" />

        <Button
            android:id="@+id/btnRastrearEntrega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Acompanhar Entrega"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/icStatusAtual"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_circle"
                android:layout_marginEnd="6dp"
                app:tint="#0AFF00" />

            <TextView
                android:id="@+id/tvStatusPedido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedido concluído às 20:35"
                android:textColor="#222"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- LINHA GOURMET -->
        <LinearLayout
            android:id="@+id/layoutStatusLinha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progressoStatus"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:minHeight="6dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:max="100"
                android:progress="25"
                android:indeterminate="false"
                android:progressDrawable="@drawable/progress_gourmet_drawable"
                android:layout_marginTop="6dp" />



            <TextView
                android:id="@+id/tvLinhaStatusCinza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aguardando a empresa confirmar seu pedido"
                android:textColor="#9E9E9E"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>


        <!-- Itens do pedido -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Itens do pedido"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerItens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_resumo_pedido" />

        <!-- Resumo valores com ícone -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_receipt"
                android:layout_marginEnd="6dp"
                app:tint="#222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resumo de valores"
                android:textStyle="bold"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResumoSubtotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtotal: R$ 0,00"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvResumoDescontos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descontos: - R$ 0,00"
            android:textColor="#008000"
            android:textSize="14sp" />


        <TextView
            android:id="@+id/tvResumoEntrega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entrega: Grátis"
            android:textSize="14sp" />

        <!-- Aviso de atraso -->
        <TextView
            android:id="@+id/tvAtrasado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Seu pedido passou do horário de entrega"
            android:textColor="#C62828"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Ações: Chat e Ligar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:visibility="gone"
            android:id="@+id/boxAtraso">

            <Button
                android:id="@+id/btnChatAtraso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chat com a loja"
                android:textColor="@android:color/white"
                android:backgroundTint="#FF9800"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnLigarLoja"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ligar para loja"
                android:textColor="@android:color/white"
                android:backgroundTint="#1976D2" />
        </LinearLayout>

        <!-- Botão repetir pedido -->
        <TextView
            android:id="@+id/tvResumoTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Total: R$ 0,00"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPedirNovamente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pedir novamente"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/vermelho"
            android:layout_marginTop="20dp" />

        <!-- Pagamento -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_credit_card"
                android:layout_marginEnd="6dp"
                app:tint="#222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pagamento"
                android:textStyle="bold"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMetodoPagamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cartão de crédito •••• 9636"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="4dp" />
        <!-- Endereço -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_location"
                android:layout_marginEnd="6dp"
                app:tint="#222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Endereço de entrega"
                android:textStyle="bold"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEnderecoEntrega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="R. Rio da Prata, 105B - Jardim Novo Oasis"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="4dp" />


        <!-- Avaliação -->
        <LinearLayout
            android:id="@+id/boxAvaliacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:visibility="gone">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avalie seu pedido:"
                android:layout_marginEnd="8dp" />

            <RatingBar
                android:id="@+id/ratingAvaliacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                android:stepSize="1.0"
                android:rating="0" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
