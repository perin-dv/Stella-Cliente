<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardEndereco"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/icCategoria"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_home"
            app:tint="@color/gourmetPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTituloEndereco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Casa"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/icCategoria"
            app:layout_constraintTop_toTopOf="@id/icCategoria"
            app:layout_constraintEnd_toStartOf="@id/btnMaisEndereco"
            app:layout_constraintHorizontal_bias="0" />

        <ImageView
            android:id="@+id/btnMaisEndereco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/gray"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtEndereco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="R. Rio da Prata, 105b - Maringá - PR"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/txtTituloEndereco"
            app:layout_constraintTop_toBottomOf="@id/txtTituloEndereco"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtComplemento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Casa Fundos"
            android:textColor="@color/gray"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/txtEndereco"
            app:layout_constraintTop_toBottomOf="@id/txtEndereco"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/icSelecionado"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/gourmetPrimary"
            app:layout_constraintTop_toBottomOf="@id/btnMaisEndereco"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
