<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvTituloCheckout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Confirmação do Pedido"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/vermelho"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvEnderecoEntrega"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Endereço de entrega"
        android:textSize="16sp"
        android:textColor="@color/colorPrimary"
        android:background="@drawable/bg_card_gourmet"
        android:padding="12dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloCheckout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnConfirmarPedido"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Finalizar Pedido"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/vermelho"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvEnderecoEntrega"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
