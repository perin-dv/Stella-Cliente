<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.Apkstelladitalia20" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores principais -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimary</item>

        <!-- Correção para TabLayout -->
        <item name="tabBackground">@android:color/transparent</item>
        <item name="tabIndicator">@null</item>
    </style>


    <!-- Estilo de botão -->
    <style name="botaoPadrao" parent="Theme.AppCompat.DayNight">
        <item name="colorControlHighlight">#DD0000</item>
        <item name="colorButtonNormal">#990000</item>
        <item name="android:textColor">@color/vermelho</item>
    </style>
</resources>
