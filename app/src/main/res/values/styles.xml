<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Estilo para textos personalizados -->
    <style name="MeuEstiloDeTexto">
        <item name="android:textColor">@color/vermelho</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Estilo para cards com elevação -->
    <style name="CardElevado">
        <item name="cardElevation">8dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <!-- Estilo para botões arredondados -->
    <style name="BotaoArredondado">
        <item name="android:backgroundTint">@color/vermelho</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/bg_botao_arredondado</item>
    </style>

</resources>
