<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sombra de fundo -->
    <item>
        <shape>
            <solid android:color="#f8f5f2" /> <!-- creme claro -->
        </shape>
    </item>

    <!-- Gradiente dourado -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <gradient
                android:startColor="#f9e4b7"
                android:centerColor="#f5deb3"
                android:endColor="#f9e4b7"
                android:angle="45" />

            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
