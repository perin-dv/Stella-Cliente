<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo bege claro -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF9F3" />
        </shape>
    </item>

    <!-- Textura sutil com degradê radial no centro -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="50%"
                android:centerY="40%"
                android:gradientRadius="600dp"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFF3E5"
                android:useLevel="false" />
        </shape>
    </item>
</layer-list>
