<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Apkstelladitalia20">

        <!-- Splash inicial -->
        <activity
            android:name="com.example.apkstelladitalia20.activity.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login e Cadastro -->
        <activity android:name="com.example.apkstelladitalia20.activity.LoginActivity" />
        <activity android:name="com.example.apkstelladitalia20.activity.CadastroActivity" />
        <activity android:name="com.example.apkstelladitalia20.activity.DadosEntregaActivity" />

        <!-- Atividades principais -->
        <activity android:name="com.example.apkstelladitalia20.activity.HomeActivity" />
                      <activity android:name="com.example.apkstelladitalia20.activity.DetalhesProdutoActivity" />
        <activity android:name="com.example.apkstelladitalia20.activity.DetalhesPromocaoActivity" />
        <activity android:name="com.example.apkstelladitalia20.activity.DetalhesPedidoActivity" />

        <activity
            android:name="com.example.apkstelladitalia20.activity.WebViewPagamentoActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <activity android:name="com.example.apkstelladitalia20.activity.AdicionarPizzaTamanhoActivity" />
        <activity android:name="com.example.apkstelladitalia20.activity.CarrinhoPromocaoActivity" />
        <activity android:name="com.example.apkstelladitalia20.activity.EnderecoEntregaActivity" />
        <activity android:name="com.example.apkstelladitalia20.activity.ResumoPedidoProdutoActivity" />
        <activity android:name="com.example.apkstelladitalia20.activity.ResumoPedidoPromocaoActivity" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />


    </application>

</manifest>
